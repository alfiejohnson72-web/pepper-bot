# These go in Railway: your service -> Variables tab. (For running on your own
# computer, copy this file to ".env".) Never share or upload real values.

# --- Already set on Railway ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# From console.anthropic.com > API keys (powers the "Help me choose" chat)
ANTHROPIC_API_KEY=

# --- New: needed for the full shop ---
# Your private team Telegram group. Send /chatid there and paste the number (starts with -100).
ADMIN_CHAT_ID=
# Where the database and product photos live. Must be on a Railway volume mounted at /data.
DB_PATH=/data/shop.db
# Your first admin dashboard login (only used the very first time, to create the owner account)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random text. Keeps dashboard logins secure. Railway can generate one: ${{secret(48)}}
SESSION_SECRET=

# --- Payments (Stripe). Start with test keys (sk_test_...), switch to live when ready ---
# Stripe dashboard > Developers > API keys > Secret key
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Optional (defaults are fine) ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_FALLBACKS=default
# Railway sets PORT itself. The dashboard only runs when PORT is set.
