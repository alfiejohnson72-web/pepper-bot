# Copy this file to ".env" and fill in the values. Never share or upload .env.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# From https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Your private team group (you + Bert + the bot). Add the bot, send /chatid there,
# and paste the number here (it usually starts with -100).
ADMIN_CHAT_ID=

# Optional settings (the defaults are fine)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_FALLBACKS=default
# On Railway, point this at a volume so leads survive restarts, e.g. /data/leads.db
DB_PATH=leads.db
